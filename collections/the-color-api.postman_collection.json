          "name": "Get Color Information",
          "request": {
            "name": "Get Color Information",
            "description": {
              "content": "Retrieve comprehensive information for a color provided in any supported format (hex, RGB, HSL, or CMYK). Returns conversions to all other color formats, the nearest named color, image URLs, and contrast color.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
