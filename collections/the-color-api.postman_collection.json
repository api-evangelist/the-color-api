                  "description": "Color as a hex code without the"
                },
                {
                  "disabled": false,
                  "key": "rgb",
                  "value": "<string>",
                  "description": "Color as comma-separated RGB values (e.g., 0,71,171) or rgb(0,71,171)."
                },
                {
                  "disabled": false,
                  "key": "hsl",
                  "value": "<string>",
                  "description": "Color as HSL values (e.g., 215,100%,34%) or hsl(215,100%,34%)."
