          "request": {
            "name": "Get Color Information",
            "description": {
              "content": "Retrieve comprehensive information for a color provided in any supported format (hex, RGB, HSL, or CMYK). Returns conversions to all other color formats, the nearest named color, image URLs, and contrast color.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "hex",
                  "value": "<string>",
                  "description": "Color as a hex code without the"
                },
                {
                  "disabled": false,
                  "key": "rgb",
                  "value": "<string>",
                  "description": "Color as comma-separated RGB values (e.g., 0,71,171) or rgb(0,71,171)."
                },
                {
                  "disabled": false,
                  "key": "hsl",
                  "value": "<string>",
                  "description": "Color as HSL values (e.g., 215,100%,34%) or hsl(215,100%,34%)."
                },
                {
                  "disabled": false,
                  "key": "cmyk",
                  "value": "<string>",
                  "description": "Color as CMYK values (e.g., 100,58,0,33) or cmyk(100,58,0,33)."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format."
                },
                {
                  "disabled": false,
                  "key": "w",
                  "value": "100",
                  "description": "Image width in pixels for SVG format responses."
                },
                {
                  "disabled": false,
                  "key": "named",
                  "value": "true",
                  "description": "Whether to include the color name on SVG image outputs."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
